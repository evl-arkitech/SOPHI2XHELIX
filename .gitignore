# ==============================================================================
# Double Helix Neural Agent Engine - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets, Environment & Local Configurations
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.pfx


# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.uv/

# ------------------------------------------------------------------------------
# Testing, Coverage & Type Checking
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# Runtime Simulation & Scratch Storage
# ------------------------------------------------------------------------------
.doublehelix_runtime_sim/
/tmp/
/temp/
*.log
logs/

# ------------------------------------------------------------------------------
# Cloudflare Edge Worker & Node.js Dependencies
# ------------------------------------------------------------------------------
node_modules/
cloudflare-edge/node_modules/
.wrangler/
cloudflare-edge/.wrangler/
cloudflare-edge/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Large Binary Files & Media Archives (Exceeds Git / GitHub 100MB limits)
# ------------------------------------------------------------------------------
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.mp4
*.mkv
*.mov
*.avi
*.exe
*.dll
Godot_v4*
**/Godot_v4*/**
.mono/
**/.mono/**

# ------------------------------------------------------------------------------
# Godot Engine Import & Cache Artifacts
# ------------------------------------------------------------------------------
.godot/
**/.godot/**
*.translation
export_presets.cfg

# ------------------------------------------------------------------------------
# Operating System & IDE Specific Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
GodMode.*

# IDEs
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Browser downloads & saved pages
*_files/
**/*_files/**
*.download
*.crdownload

